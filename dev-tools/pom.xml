<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.mkoehler.launchwindow</groupId>
    <artifactId>launchwindow-parent</artifactId>
    <version>0</version>
  </parent>

  <!-- Developer tools that are never shipped: not shaded, not packaged by any release
       workflow. -->
  <artifactId>launchwindow-dev-tools</artifactId>
  <packaging>jar</packaging>
  <name>LaunchWindow-dev-tools</name>

  <properties>
    <mainClass>de.mkoehler.launchwindow.devtools.DevClient</mainClass>
    <replayer.pack>standard</replayer.pack>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.mkoehler.launchwindow</groupId>
      <artifactId>launchwindow-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- Only needed for the MenuHotspotPrototype (a windowed libGDX app), not DevClient
           itself - pulled in here anyway since dev-tools has a single shared classpath. -->
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-backend-lwjgl3</artifactId>
      <version>${gdxVersion}</version>
    </dependency>
    <dependency>
      <!-- Every native-backed libGDX piece needs its own *-platform natives-desktop dependency,
           independently, in every runnable module - missing one only fails at runtime. -->
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-platform</artifactId>
      <version>${gdxVersion}</version>
      <classifier>natives-desktop</classifier>
    </dependency>
    <dependency>
      <!-- The MissionReplayer runs the client's own screens, which need its fonts and video. -->
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-freetype-platform</artifactId>
      <version>${gdxVersion}</version>
      <classifier>natives-desktop</classifier>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.gdx-video</groupId>
      <artifactId>gdx-video-lwjgl3</artifactId>
      <version>1.3.4</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Run the dev client directly with: mvn -pl dev-tools compile exec:java
             (core must already be installed locally). Run a different tool's main
             class instead by overriding the mainClass *property* this plugin's
             own config reads below, e.g.:
             mvn -pl dev-tools compile exec:java -DmainClass=de.mkoehler.launchwindow.devtools.MenuHotspotPrototype
             (-Dexec.mainClass does not work here - it's overridden right back by
             this plugin's own <configuration> below, which always reads ${mainClass}). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
        </configuration>
        <executions>
          <execution>
            <!-- The MissionReplayer in its own JVM, run from assets/ as the client is, so the clips,
                 sidecars and sounds are read fresh from disk. It puts assets/ on its own class loader:
                 never on this module's classpath, where the bots would pick up the decisions and
                 stories (Decisions.standard()):
                 mvn -pl dev-tools compile exec:exec@replayer (-Dreplayer.pack=early-era for the
                 small pack). -->
            <id>replayer</id>
            <configuration>
              <executable>java</executable>
              <workingDirectory>${project.basedir}/../assets</workingDirectory>
              <arguments>
                <argument>--enable-native-access=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <classpath/>
                <argument>de.mkoehler.launchwindow.devtools.replay.MissionReplayer</argument>
                <argument>${replayer.pack}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- The HandsOnPlayground: any hands-on level's puzzle on its own, with the client's own
                 screen, its levels read fresh from assets/content/standard/decisions.json. assets/ on its own
                 class loader, as the replayer's:
                 mvn -pl dev-tools compile exec:exec@handson -->
            <id>handson</id>
            <configuration>
              <executable>java</executable>
              <workingDirectory>${project.basedir}/../assets</workingDirectory>
              <arguments>
                <argument>--enable-native-access=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <classpath/>
                <argument>de.mkoehler.launchwindow.devtools.handson.HandsOnPlayground</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
