<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers jgitver as a Maven core extension: it computes ${project.version}
  for every module in this reactor from git tags/history, before the build
  starts, replacing the placeholder "0" declared in the pom.xml files. Same
  scheme as the sibling projects (StarWars/Robot-Rampage). No branch-policy
  override is needed here, unlike Robot-Rampage's: jgitver already omits the
  branch qualifier by default for a branch named "master", which is this
  repo's default branch (Robot-Rampage's default branch is "main", hence its
  extra .mvn/jgitver.config.xml).
-->
<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.0.0 http://maven.apache.org/xsd/core-extensions-1.0.0.xsd">
  <extension>
    <groupId>fr.brouillard.oss</groupId>
    <artifactId>jgitver-maven-plugin</artifactId>
    <version>1.9.0</version>
  </extension>
</extensions>
